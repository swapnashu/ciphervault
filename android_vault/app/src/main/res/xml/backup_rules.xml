<?xml version="1.0" encoding="utf-8"?>
<!-- Vault contents must never reach Android Auto Backup or cloud device transfer.
     allowBackup is false in the manifest; these files exist so the references
     resolve if a device policy or OEM backup agent still queries them. -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
