<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ / 13+ device-to-device transfer rules.
     The encrypted blob is fine to move, but the Keystore key and any cached
     auth material must stay on the original device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
